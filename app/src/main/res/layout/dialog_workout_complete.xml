<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Celebration -->
    <TextView
        android:id="@+id/tvCompletionMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎉 Great work!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:gravity="center"
        android:layout_marginBottom="14dp"/>

    <!-- Bonus tip -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E8F5E9"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvBonusTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tip..."
            android:textSize="13sp"
            android:textColor="#2E7D32"
            android:padding="14dp"
            android:lineSpacingExtra="3dp"/>
    </androidx.cardview.widget.CardView>

    <!-- Rating -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How was this workout?"
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginBottom="6dp"/>

    <RatingBar
        android:id="@+id/workoutRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:rating="4"
        android:stepSize="1"
        android:layout_marginBottom="14dp"/>

    <!-- Notes -->
    <EditText
        android:id="@+id/etWorkoutNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Add a note (optional) — how did it feel?"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:background="#F5F5F5"
        android:padding="10dp"/>

</LinearLayout>