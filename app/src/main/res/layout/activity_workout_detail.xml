<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GIF hero area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="#1A1A2E">

            <ImageView
                android:id="@+id/detailImgGif"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:alpha="0.92"/>

            <TextView
                android:id="@+id/tvGifLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Loading..."
                android:textSize="13sp"
                android:textColor="#AAAAAA"/>

            <!-- Gradient overlay for readability -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_bottom_dark"/>

            <!-- Back button -->
            <ImageView
                android:id="@+id/btnDetailBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="#88000000"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Share button top-right -->
            <Button
                android:id="@+id/btnShareWorkout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:text="📤 Share"
                android:textSize="12sp"
                android:backgroundTint="#88000000"
                android:textColor="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

            <!-- Name + difficulty overlay on image -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/detailTvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Exercise Name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"/>

                <TextView
                    android:id="@+id/detailTvDifficulty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beginner"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#43A047"
                    android:background="#CC000000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Content padding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Category + Goal badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/detailTvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chest"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#3949AB"
                    android:background="#EEF2FF"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/detailTvGoal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔥 Lose Weight"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:background="#FFF3E0"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/tvCaloriesBig"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:text="0\nkcal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#E64A19"
                    android:lineSpacingMultiplier="0.9"/>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/detailTvDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="15sp"
                android:textColor="#444444"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="14dp"/>

            <!-- Stats bar card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F0F4FF"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/detailTvStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:text="3 sets · 15 reps · 15min · 🔥 120 kcal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#3949AB"
                    android:gravity="center"/>
            </androidx.cardview.widget.CardView>

            <!-- Equipment -->
            <TextView
                android:id="@+id/detailTvEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏋️ Equipment: None"
                android:textSize="13sp"
                android:textColor="#555555"
                android:background="#F5F5F5"
                android:padding="10dp"
                android:layout_marginBottom="20dp"/>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- SET TRACKER                                        -->
            <!-- ══════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Set Tracker"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:layout_marginBottom="12dp"/>

                    <ProgressBar
                        android:id="@+id/progressSets"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:max="3"
                        android:progress="1"
                        android:progressTint="#3949AB"
                        android:layout_marginBottom="10dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <Button
                            android:id="@+id/btnPrevSet"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="◀"
                            android:textSize="16sp"
                            android:backgroundTint="#EEF2FF"
                            android:textColor="#3949AB"
                            android:padding="0dp"/>

                        <TextView
                            android:id="@+id/tvSetProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Set 1 of 3"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:gravity="center"/>

                        <Button
                            android:id="@+id/btnNextSet"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="▶"
                            android:textSize="16sp"
                            android:backgroundTint="#3949AB"
                            android:textColor="#FFFFFF"
                            android:padding="0dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- REST TIMER                                          -->
            <!-- ══════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱️ Rest Timer"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rest timer auto-set for your difficulty level"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/tvWorkoutTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01:30"
                        android:textSize="52sp"
                        android:textStyle="bold"
                        android:textColor="#43A047"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnStartTimer"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="2"
                            android:text="▶ Start Rest Timer"
                            android:textSize="13sp"
                            android:backgroundTint="#3949AB"
                            android:textColor="#FFFFFF"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btnResetTimer"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="↺ Reset"
                            android:textSize="13sp"
                            android:backgroundTint="#F0F4FF"
                            android:textColor="#3949AB"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- MUSCLES TARGETED                                   -->
            <!-- ══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💪 Muscles Targeted"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="10dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:id="@+id/detailMuscleChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="2dp"/>
            </HorizontalScrollView>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="20dp"/>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- HOW TO DO IT                                       -->
            <!-- ══════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📋 How To Do It"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/detailStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="20dp"/>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- BREATHING GUIDE                                    -->
            <!-- ══════════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E3F2FD"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌬️ Breathing Guide"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/detailTvBreathing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Breathing tip"
                        android:textSize="14sp"
                        android:textColor="#1565C0"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- POINTS TO REMEMBER                                 -->
            <!-- ══════════════════════════════════════════════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Points To Remember"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="14dp"/>

            <LinearLayout
                android:id="@+id/detailPointsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginBottom="20dp"/>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- MARK COMPLETE                                      -->
            <!-- ══════════════════════════════════════════════════ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailComplete"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="✅ Mark As Complete"
                android:textSize="17sp"
                android:backgroundTint="#3949AB"
                app:cornerRadius="16dp"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>