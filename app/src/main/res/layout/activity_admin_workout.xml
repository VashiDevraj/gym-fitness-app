<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F2F8">

    <!-- Header card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#1A1A2E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💪 Manage Workouts"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvAdminWorkoutCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 workouts"
                    android:textSize="13sp"
                    android:textColor="#8899BB"
                    android:background="#2A2A3E"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Filter row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goal:"
                    android:textSize="12sp"
                    android:textColor="#8899BB"
                    android:layout_marginEnd="6dp"/>

                <Spinner
                    android:id="@+id/spinnerAdminFilterGoal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:layout_marginEnd="14dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category:"
                    android:textSize="12sp"
                    android:textColor="#8899BB"
                    android:layout_marginEnd="6dp"/>

                <Spinner
                    android:id="@+id/spinnerAdminFilterCat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressAdminWorkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone"/>

    <!-- Empty state -->
    <TextView
        android:id="@+id/tvAdminEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="40dp"
        android:text="No workouts found.\nTap ➕ to add your first workout!"
        android:textSize="14sp"
        android:textColor="#AAAAAA"
        android:visibility="gone"/>

    <!-- Workout list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminWorkouts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Add button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddWorkout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="➕  Add New Workout"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#3949AB"
        app:cornerRadius="0dp"
        style="@style/Widget.MaterialComponents.Button"/>

</LinearLayout>