<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Status color bar -->
        <View android:id="@+id/statusIndicatorBar"
            android:layout_width="6dp" android:layout_height="match_parent"
            android:background="#43A047"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- Name + status -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_marginBottom="4dp">
                <TextView android:id="@+id/tvEquipName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Equipment Name"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#1A1A2E"/>
                <TextView android:id="@+id/tvEquipStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Working" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="#43A047"/>
            </LinearLayout>

            <TextView android:id="@+id/tvEquipDesc"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Description" android:textSize="13sp" android:textColor="#666666"
                android:layout_marginBottom="6dp"/>

            <!-- Location + category row -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tvEquipLocation"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="📍 Ground Floor"
                    android:textSize="12sp" android:textColor="#888888"/>
                <TextView android:id="@+id/tvEquipCategory"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Strength" android:textSize="11sp" android:textColor="#3949AB"
                    android:background="#EEF2FF" android:paddingStart="8dp"
                    android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
            </LinearLayout>

            <TextView android:id="@+id/tvEquipReports"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="11sp" android:textColor="#FF9800"
                android:layout_marginBottom="8dp"/>

            <TextView android:id="@+id/btnReportEquip"
                android:layout_width="match_parent" android:layout_height="40dp"
                android:gravity="center" android:text="Report Issue"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="#F57F17" android:background="#FFF8E1"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>