<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp" app:cardCornerRadius="12dp"
    app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="4dp">
            <TextView android:id="@+id/tvAdminEquipName" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Equipment" android:textSize="15sp" android:textStyle="bold"
                android:textColor="#1A1A2E"/>
            <TextView android:id="@+id/tvAdminEquipStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Working"
                android:textSize="12sp" android:textStyle="bold" android:textColor="#43A047"/>
        </LinearLayout>

        <TextView android:id="@+id/tvAdminEquipMeta" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Meta"
            android:textSize="11sp" android:textColor="#888888" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/tvAdminEquipReports" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text=""
            android:textSize="11sp" android:textColor="#FF9800" android:layout_marginBottom="10dp"/>

        <!-- Status buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="8dp">
            <TextView android:id="@+id/btnSetWorking" android:layout_width="0dp"
                android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
                android:text="Working" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#2E7D32" android:background="#E8F5E9" android:layout_marginEnd="4dp"/>
            <TextView android:id="@+id/btnSetRepair" android:layout_width="0dp"
                android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
                android:text="Needs Repair" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#E65100" android:background="#FFF3E0" android:layout_marginEnd="4dp"/>
            <TextView android:id="@+id/btnSetOut" android:layout_width="0dp"
                android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
                android:text="Out of Order" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#C62828" android:background="#FFEBEE"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/btnAdminEditEquip" android:layout_width="0dp"
                android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
                android:text="✏️ Edit" android:textSize="12sp" android:textStyle="bold"
                android:textColor="#3949AB" android:background="#EEF2FF" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/btnAdminDeleteEquip" android:layout_width="0dp"
                android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
                android:text="🗑 Delete" android:textSize="12sp" android:textStyle="bold"
                android:textColor="#E53935" android:background="#FFEBEE"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>