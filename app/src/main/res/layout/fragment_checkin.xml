<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Check In hero card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="24dp" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🏋️" android:textSize="48sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gym Attendance" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="#1A1A2E" android:layout_marginBottom="4dp"/>
                <TextView android:id="@+id/tvCheckinStatus" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="You haven't checked in today yet"
                    android:textSize="14sp" android:textColor="#888888" android:layout_marginBottom="20dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckIn" android:layout_width="match_parent"
                    android:layout_height="56dp" android:text="Check In Now"
                    android:textSize="16sp" android:backgroundTint="#3949AB"
                    app:cornerRadius="16dp" style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Stats row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="16dp">

            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="5dp" app:cardCornerRadius="16dp"
                app:cardElevation="2dp" app:cardBackgroundColor="#E8EAF6">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="All time" android:textSize="10sp" android:textColor="#5C6BC0"/>
                    <TextView android:id="@+id/tvTotalCheckins" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textSize="26sp" android:textStyle="bold" android:textColor="#3949AB"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="visits" android:textSize="10sp" android:textColor="#5C6BC0"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#E8F5E9">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="This month" android:textSize="10sp" android:textColor="#43A047"/>
                    <TextView android:id="@+id/tvThisMonth" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textSize="26sp" android:textStyle="bold" android:textColor="#2E7D32"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="visits" android:textSize="10sp" android:textColor="#43A047"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="3dp" android:layout_marginEnd="3dp"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFF3E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Streak 🔥" android:textSize="10sp" android:textColor="#E65100"/>
                    <TextView android:id="@+id/tvStreakCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0"
                        android:textSize="26sp" android:textStyle="bold" android:textColor="#BF360C"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="days" android:textSize="10sp" android:textColor="#E65100"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="5dp" app:cardCornerRadius="16dp"
                app:cardElevation="2dp" app:cardBackgroundColor="#FCE4EC">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Attendance" android:textSize="10sp" android:textColor="#C2185B"/>
                    <TextView android:id="@+id/tvAttendancePct" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0%"
                        android:textSize="22sp" android:textStyle="bold" android:textColor="#880E4F"/>
                    <TextView android:id="@+id/tvLastCheckin" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="—"
                        android:textSize="10sp" android:textColor="#C2185B"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Calendar card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <!-- Month header -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:id="@+id/tvCurrentMonth"
                        android:text="March 2026" android:textSize="15sp"
                        android:textStyle="bold" android:textColor="#1A1A2E"/>
                    <!-- Legend -->
                    <View android:layout_width="14dp" android:layout_height="14dp"
                        android:background="@drawable/circle_green" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Visited" android:textSize="11sp" android:textColor="#555555"
                        android:layout_marginEnd="10dp"/>
                    <View android:layout_width="14dp" android:layout_height="14dp"
                        android:background="@drawable/circle_blue_outline" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Today" android:textSize="11sp" android:textColor="#555555"/>
                </LinearLayout>

                <!-- Day headers Mon–Sun -->
                <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="7" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="M" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="T" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="W" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="T" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="F" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="S" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_columnWeight="1" android:text="S" android:gravity="center"
                        android:textSize="11sp" android:textColor="#AAAAAA" android:textStyle="bold"/>
                </GridLayout>

                <!-- Calendar dot grid — filled by code -->
                <GridLayout
                    android:id="@+id/calendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="7"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>