<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymApplication"
        tools:targetApi="31">
        <activity
            android:name=".AdminWorkoutActivity"
            android:exported="false" />
        <activity android:name=".MemberDetailActivity"
            android:windowSoftInputMode="adjustResize"/>
        <!-- Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Health Connect permission controller -->
        <activity
            android:name="androidx.health.connect.client.PermissionController"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="androidx.health.connect.client.PermissionController">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias> <!-- Core dashboard -->
        <activity
            android:name=".UserDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".TrainerPanelActivity"
            android:exported="false" /> <!-- Onboarding / profile setup -->
        <activity
            android:name=".MainActivity2"
            android:exported="false" />
        <activity
            android:name=".MainActivity3"
            android:exported="false" />
        <activity
            android:name=".MainActivity4"
            android:exported="false" />
        <activity
            android:name=".MainActivity5"
            android:exported="false" />
        <activity
            android:name=".MainActivity6"
            android:exported="false" /> <!-- Charts & stats -->
        <!-- FIX: removed duplicate StepChartActivity entry — one entry only -->
        <activity
            android:name=".StepChartActivity"
            android:exported="false" />
        <activity
            android:name=".WeightStatsActivity"
            android:exported="false" /> <!-- Workouts -->
        <activity
            android:name=".WorkoutListActivity"
            android:exported="false" /> <!-- FIX: added missing WorkoutDetailActivity — was causing crashes on card tap -->
        <activity
            android:name=".WorkoutDetailActivity"
            android:exported="false"
            android:parentActivityName=".UserDashboardActivity" />
    </application>

</manifest>